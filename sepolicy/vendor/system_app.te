# system_app.te

binder_call(system_app, cacaoserver)
binder_call(system_app, cnd)
binder_call(system_app, hal_audio_default)
binder_call(system_app, hal_power_default)
binder_call(system_app, hal_rcsservice)
binder_call(system_app, hal_wifi_default)

allow system_app hal_datafactory_hwservice:hwservice_manager find;

allow system_app proc_vmallocinfo:file { r_file_perms };

# Allow com.android.settings to read zram info via sysfs
allow system_app sysfs_zram:dir { search };
allow system_app sysfs_zram:file { r_file_perms };

get_prop(system_app, wfd_prop)
# dataservice_app
get_prop(system_app, vendor_cnd_vendor_prop)

# Allow Xperia Parts to enable/disable SmartStamina
set_prop(system_app, vendor_clearpad_prop)
get_prop(system_app, vendor_clearpad_prop)

# Allow Xperia Parts to choose the NFC controller (auto|nxp|felica). It also sets
# persist.nfc_cfg.config_file_name so the NCI stack loads the matching tuning
# file; that is nfc_prop, which system_app may already set
# (system/sepolicy/private/app.te).
set_prop(system_app, vendor_nfc_variant_prop)
get_prop(system_app, vendor_nfc_variant_prop)

# ...and to read back which controller the boot-time selector actually found, so
# it can set persist.nfc_cfg.config_file_name to match. Without this the read is
# denied, SystemProperties.get returns "", and BootReceiver silently skips the
# config — the NFC driver and HAL end up correct while the NCI tuning file does
# not, which is a much harder failure to spot than an outright one.
get_prop(system_app, vendor_nfc_hw_prop)

# Allow Xperia Parts to choose the CPU/GPU tuning profile. This is the whole of
# its access: it gets no write permission on cpufreq or kgsl nodes, which stay
# with hal_power_default.
set_prop(system_app, vendor_perf_profile_prop)
get_prop(system_app, vendor_perf_profile_prop)

# 允許系統 App 讀取 GPU 狀態
allow system_app sysfs_kgsl:dir search;
allow system_app sysfs_kgsl:file r_file_perms;
allow system_app sysfs_kgsl:lnk_file read;
