# dontaudit suppresses denials at POLICY COMPILE TIME -- there is no runtime
# toggle. During the SELinux enforcing transition these must be lifted, or the
# collected corpus silently omits whatever they mask.
#
# Collection build:  make WITH_SELINUX_COLLECT=true ... (sets BOARD_SEPOLICY_M4DEFS
# += lilac_collect_denials), which compiles these OUT so the denials surface.
# Normal builds are unchanged.
#
# NOTE: m4 has no `ifndef' -- the two-branch `ifdef(name, if-defined, if-not)'
# is required. Soong passes defs as `-D name' (empty value), so testing the
# VALUE (e.g. ifelse) would not work; only definedness can be tested. Verified
# both ways with `m4 --fatal-warnings' before committing.
ifdef(`lilac_collect_denials', `', `

dontaudit vendor_init build_prop:property_service set;
dontaudit vendor_init userdebug_or_eng_prop:property_service set;

dontaudit hal_nfc_default hal_secure_element_hwservice:hwservice_manager find;

dontaudit cacaoserver shell_data_file:dir search;

dontaudit {
  adpl
  atfwd
  cnd
  hal_bluetooth_qti
  hal_dpmQmiMgr
  hal_gnss_qti
  hal_imsrtp
  hal_rcsservice
  hal_sensors_default
  ims
  location
  netmgrd
  qti
  qtidataservices_app
  rild
  sensors
  thermal-engine
  time_daemon
  vendor_pd_mapper
  vendor_per_mgr
  wcnss_service
} oneplus_prop:file read;

dontaudit {
  adpl
  cnd
  hal_dpmQmiMgr
  hal_gnss_qti
  hal_imsrtp
  hal_rcsservice
  ims
  location
  netmgrd
  port-bridge
  qti
  qtidataservices_app
  rild
  thermal-engine
  time_daemon
  wcnss_service
  } vendor_target_id_prop:file read;

')
