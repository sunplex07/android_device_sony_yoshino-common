cc_library {
    name: "libdisppower",
    proprietary: true,
    srcs: ["disp-power/InteractionHandler.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libperfmgr",
        "libutils",
    ],
    static_libs: [
        "powerhal_flags-aconfig-cc",
    ],
}

cc_binary {
    name: "android.hardware.power-service.yoshino-libperfmgr",
    relative_install_path: "hw",
    init_rc: ["aidl/android.hardware.power-service.yoshino-libperfmgr.rc"],
    vintf_fragments: ["aidl/android.hardware.power-service.yoshino.xml"],
    vendor: true,
    shared_libs: [
        "android.hardware.power-V2-ndk",
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
        "libbinder_ndk",
        "libdisppower",
        "libperfmgr",
        "libprocessgroup",
        "pixel-power-ext-V1-ndk",
    ],
    static_libs: [
        "powerhal_flags-aconfig-cc",
    ],
    srcs: [
        "aidl/service.cpp",
        "aidl/Power.cpp",
        "aidl/PowerExt.cpp",
        "aidl/PowerHintSession.cpp",
        "aidl/PowerSessionManager.cpp",
    ],
}
