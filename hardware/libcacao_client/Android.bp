cc_library_shared {
    name: "libcacao_client",
    compile_multilib: "both",
    srcs: [
        "ICacao.cpp",
        "cacao_impl.cpp",
        "ImageBuf.cpp",
        "Cacao.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-DDO_NOT_CHECK_MANUAL_BINDER_INTERFACES",
        "-Wno-invalid-offsetof",
    ],
    shared_libs: [
        "libbinder",
        "libutils",
        "libcutils",
        "liblog",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.allocator@2.0",
        "libhidlbase",
    ],
}
