<?xml version="1.0" encoding="utf-8"?>
<!--
    Privileged-permission allowlist for the ported Sony camera stack.

    Android 16 refuses to boot if a /system/priv-app requests a signature|privileged permission
    that is not allowlisted here - system_server throws
        IllegalStateException: Signature|privileged permissions not in privileged permission allowlist
    and the device bootloops. That is not hypothetical: it happened on this device the first time
    SemcCameraUI was installed as a priv-app.

    Entries for packages that are not installed are ignored, so the companion apps below are listed
    up front to make installing them safe.
-->
<permissions>
    <privapp-permissions package="com.sonyericsson.android.camera">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="android.permission.STOP_APP_SWITCHES"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>

    <!-- Mode-registration hub for the addon capturing modes, and the target of the camera's
         gyro-calibration intent (REQUEST_SOMC_CAMERA_SERVICE). -->
    <privapp-permissions package="com.sonymobile.cameracommon">
        <permission name="android.permission.DEVICE_POWER"/>
    </privapp-permissions>

    <!-- Sony Album: gallery handoff (com.sonymobile.album.action.VIEW) and the fast-view service
         the camera binds for its post-capture thumbnail animation. -->
    <privapp-permissions package="com.sonyericsson.album">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
    </privapp-permissions>

    <!-- Addon capturing modes that ship in the G8441 firmware. -->
    <privapp-permissions package="com.sonymobile.android.addoncamera.soundphoto">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
    </privapp-permissions>

    <privapp-permissions package="com.sonyericsson.android.addoncamera.artfilter">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
    </privapp-permissions>

    <!-- Panorama ("3D Creator"/sweep panorama) addon mode. Requests WRITE_MEDIA_STORAGE like the
         other capture modes; without this entry system_server throws IllegalStateException at boot
         once CameraPanorama is shipped as a priv-app. -->
    <privapp-permissions package="com.sonyericsson.android.camera3d">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
    </privapp-permissions>

    <!-- SomcMediaShim: somcmedia provider shim that re-issues the camera's queries against
         standard MediaStore (the camera otherwise queries the Sony-custom "somcmedia" authority,
         which AOSP MediaProvider rejects and the in-app thumbnail stays blank). Needs
         WRITE_MEDIA_STORAGE so it can read MediaStore on the camera's behalf without runtime
         grants. See docs/05_THUMBNAIL_ROOT_CAUSE.md and docs/06_THUMBNAIL_FIX.md in lilac-eis. -->
    <privapp-permissions package="com.sonyericsson.somcmedia.shim">
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
    </privapp-permissions>
</permissions>
